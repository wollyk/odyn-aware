[Unit]
Description=AuroraView object tracker (YOLOv8s + ByteTrack persistent loop)
After=network.target
# Don't take the api server down with us.
Wants=odyn-api.service

[Service]
Type=simple
User=kamal
Group=kamal
WorkingDirectory=/var/www/odyn-aware/current/services/tracker
# Reuse the api server's env file so we get FRIGATE_BASE / FRIGATE_USER /
# FRIGATE_PASS without duplicating secrets. The tracker only consumes
# those three keys; everything else is ignored.
EnvironmentFile=/etc/odyn-aware/api.env
Environment=TRACKER_HOST=127.0.0.1
Environment=TRACKER_PORT=8767
# Pre-downloaded by install.sh — see weapon-detector.service for why this
# absolute path matters under ProtectSystem=strict.
Environment=TRACKER_MODEL=/var/lib/auroraview-tracker/yolov8s.pt
Environment=TRACKER_FPS=5
# 720 is a meaningful upgrade over the 480 the polling path uses; YOLOv8s
# benefits from the extra pixels on small/distant subjects (the original
# "boxes too big on people walking around" complaint).
Environment=TRACKER_SNAPSHOT_HEIGHT=720
Environment=TRACKER_IMGSZ=640
Environment=TRACKER_CONF=0.30
Environment=TRACKER_IOU=0.45
# Tight allowlist for "miss-rather-than-mistag". Excludes COCO long-tail
# classes that are common YOLOv8s mis-fires for clothing/bags/static
# objects (suitcase, backpack, umbrella, handbag). Add more here only if
# operators ask for them.
Environment="TRACKER_CLASSES=person,bicycle,car,motorcycle,bus,truck,dog,cat"
# Modal-class voting parameters. See _TrackVoter in app.py for the
# rationale. Defaults are tuned for security-camera scenes; raise
# VOTE_MAJORITY (e.g. 0.7) if the operator complains about strobe, or
# lower MIN_TRACK_FRAMES (e.g. 2) if real objects feel too slow to
# appear.
Environment=TRACKER_MIN_FRAMES=3
Environment=TRACKER_VOTE_WINDOW=8
Environment=TRACKER_VOTE_MAJORITY=0.6
# Per-class voted-conf floors (after voting, not raw YOLO conf). Raise
# any single class here to make it stricter without affecting others.
Environment="TRACKER_PER_CLASS_CONF=person=0.50,car=0.55,truck=0.55,bus=0.55,motorcycle=0.55,bicycle=0.55,dog=0.60,cat=0.60"
Environment=TRACKER_PER_CLASS_DEFAULT_CONF=0.55

# ---- Phase 11A: motion classification + VLM verification --------------
# A track is classified static when IoU(newest, oldest) over an 8-frame
# window stays >=STATIC_IOU. Static tracks get one VLM check (Moondream
# via Ollama on the LAN) before being emitted; unverified static tracks
# are suppressed (operator preference: miss > mistag). Moving tracks
# bypass the VLM entirely.
Environment=TRACKER_MOTION_WINDOW=8
Environment=TRACKER_MIN_MOTION_FRAMES=5
Environment=TRACKER_STATIC_IOU=0.85
Environment=TRACKER_MIN_STATIC_DWELL_S=2.0
# Master toggle for VLM. If Ollama is down, set this to false to skip
# the verification path; static tracks will then emit unconditionally.
Environment=TRACKER_VLM_VERIFY=true
Environment=TRACKER_STATIC_REQUIRE_VERIFY=true
# Ollama defaults match server/harness/tier2.mjs so we hit the same
# model the rest of the harness uses.
Environment=OLLAMA_BASE=http://192.168.0.137:11434
Environment=OLLAMA_VLM_MODEL=moondream:latest
Environment=TRACKER_VLM_TIMEOUT_S=10
Environment=TRACKER_VLM_CONCURRENCY=2
Environment=TRACKER_VLM_VERDICT_TTL_S=300
Environment=TRACKER_VLM_RETRY_COOLDOWN_S=30
Environment=TRACKER_CROP_PAD_RATIO=0.15

# ---- Phase 11B: persisted track timeline ------------------------------
# Sidecar POSTs session state to the Node API on this URL with the
# shared secret in X-Tracker-Secret. Node verifies the secret and
# upserts into track_observations. If TRACKER_INGEST_SECRET is empty,
# the ingest loop refuses to start and Node refuses to accept — this
# is the secure default for unconfigured deploys.
Environment=TRACKER_INGEST_URL=http://127.0.0.1:3001/api/tracker/ingest
Environment=TRACKER_INGEST_INTERVAL_S=10
Environment=TRACKER_INGEST_FRESH_WINDOW_S=30
Environment=TRACKER_SESSION_TTL_S=120
# TRACKER_INGEST_SECRET MUST be set in /etc/odyn-aware/api.env so both
# the Node api server and the python sidecar see the same value. We
# don't set it here so it isn't in the unit file.
# Frigate runs on a self-signed cert locally; allow it.
Environment=FRIGATE_VERIFY=false
# Ultralytics caches go under HOME / XDG_CONFIG_HOME — pin to a writable
# absolute path because ProtectSystem=strict makes everything else r/o.
Environment=HOME=/var/lib/auroraview-tracker
Environment=XDG_CONFIG_HOME=/var/lib/auroraview-tracker/.config
Environment=YOLO_CONFIG_DIR=/var/lib/auroraview-tracker/.config/Ultralytics
ExecStart=/var/www/odyn-aware/current/services/tracker/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8767 --log-level info --ws websockets
Restart=on-failure
RestartSec=5
# First boot loads torch + warms up YOLOv8s. 180s is generous; typical
# warm restart is <10s.
TimeoutStartSec=180
KillSignal=SIGTERM
TimeoutStopSec=15

# Security hardening — sidecar is a single-purpose HTTP/WS service.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/auroraview-tracker
ProtectHome=true
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
